{
  "name": "@lunaroute/opencode-extension",
  "version": "0.4.1",
  "description": "OpenCode plugin for LunaRoute: /connect login, model sync, attribution, and hosted MCP.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "lunaroute"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunaroute/lunaroute-opencode-extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:config": "node --test scripts/*.node-test.mjs",
    "check": "npm run typecheck && npm test && npm run test:config"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
}
